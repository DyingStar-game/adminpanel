# Copy to .env.local (read by docker/docker-compose.yml and the BFF in dev).
# `make up` / `make start` create it from this file on first run.

# BFF HTTP port.
PORT=3000

# Game servers the admin can target (JSON array, one line). Internal URLs stay in the BFF and
# are never sent to the browser. Fields: id, name, environment, persistenceUrl.
SERVERS='[{"id":"universe-testing","name":"Universe Testing","environment":"testing","persistenceUrl":"http://46.231.240.213:31001"}]'

# Timeout of each persistence call, and lifetime of coalesced reads shared by viewers.
PERSISTENCE_TIMEOUT_MS=5000
READ_CACHE_TTL_MS=500

# Object type definitions (*_def.json) — repository, folder and branch to read them from.
DEFINITIONS_REPO=DyingStar-game/horizonserver
DEFINITIONS_PATH=ds_genericprops/props
DEFINITIONS_REF=develop

# Optional: GitHub token for a higher API rate limit when reading definitions.
GITHUB_TOKEN=
