# Copy to .env.local (read by docker/docker-compose.yml and the BFF in dev).

# BFF HTTP port.
PORT=3000

# Game servers the admin can target (JSON array). Internal URLs stay in the BFF.
# SERVERS='[{"id":"universe-testing","name":"Universe Testing","environment":"testing","persistenceUrl":"http://service-persistence:3001"}]'
SERVERS=[]

# Optional: GitHub token for a higher API rate limit when reading *_def.json.
GITHUB_TOKEN=
