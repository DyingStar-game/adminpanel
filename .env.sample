# Copy to .env.local (read by docker/docker-compose.yml and the BFF in dev).
# `make up` / `make start` create it from this file on first run.

# BFF HTTP port.
PORT=3000

# Environment this panel serves (testing = pre-production, production…). One panel is deployed
# per environment, with that environment's Keycloak and its one game server (ADR 0023).
ENVIRONMENT=testing

# The game server of this environment, shown in the top bar (ADR 0024).
GAME_SERVER_NAME=Universe Testing

# Game services of this environment (ADR 0024). Internal URLs stay in the BFF and are never sent
# to the browser; unset, the service is hidden. Persistence without `/items`, social without
# `/api`. Locally, `make up K8S=1` sets SOCIAL_URL to the back team's minikube `social`.
PERSISTENCE_URL=http://46.231.240.213:31001
SOCIAL_URL=
# The panel's service account for social's internal API: organisation management (ADR 0023).
# Without its secret, organisations stay readable but not managed. `make up K8S=1` reads it
# from minikube.
SVC_ADMIN_CLIENT_ID=svc-admin
SVC_ADMIN_CLIENT_SECRET=
SERVICE_TIMEOUT_MS=5000

# Timeout of each persistence call, and lifetime of coalesced reads shared by viewers.
PERSISTENCE_TIMEOUT_MS=5000
READ_CACHE_TTL_MS=500

# Keycloak sign-in (ADR 0023), required. Defaults: the local Keycloak of docker-compose.yml
# (http://localhost:8080, test users in docker/keycloak/README.md). Shared Keycloaks never
# redirect to localhost: a panel on a developer's machine always signs in here.
# Issuer as the browser sees it, and where the BFF reads it from inside compose.
OIDC_ISSUER=http://localhost:8080/realms/dyingstar
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/dyingstar
OIDC_CLIENT_ID=dyingstar-admin
OIDC_CLIENT_SECRET=dyingstar-admin-local
# Origin the browser uses (deployments); unset, each request's origin (localhost:5173 or :3000).
PUBLIC_URL=
# Idle lifetime of a panel session (ms).
SESSION_TTL_MS=43200000

# Object type definitions (*_def.json) — repository, folder and branch to read them from.
DEFINITIONS_REPO=DyingStar-game/horizonserver
DEFINITIONS_PATH=ds_genericprops/props
DEFINITIONS_REF=develop

# Optional: GitHub token for a higher API rate limit when reading definitions.
GITHUB_TOKEN=
