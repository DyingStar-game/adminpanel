{
  "name": "dyingstar-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin panel for DyingStar game servers",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"pnpm --filter @dyingstar/backend dev\" \"pnpm --filter @dyingstar/frontend dev\"",
    "build": "pnpm -r build",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
