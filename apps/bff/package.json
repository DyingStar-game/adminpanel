{
  "name": "@dyingstar-admin/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs",
    "start": "node --env-file-if-exists=../../.env.local dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "definitions:update": "tsx src/scripts/update-definitions.ts"
  },
  "dependencies": {
    "@dyingstar-admin/schemas": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "dequal": "^2.0.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "lru-cache": "^11.5.3",
    "openid-client": "^6.8.8",
    "p-limit": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dyingstar-admin/testing": "workspace:*",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.0",
    "msw": "^2.15.0",
    "tsx": "^4.23.15"
  }
}
