{
  "realm": "dyingstar",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Moderation (social): above moderator. Not in the back team's realms yet"
      },
      {
        "name": "supervisor",
        "description": "Moderation (social): above admin. Not in the back team's realms yet"
      }
    ],
    "client": {
      "dyingstar-admin": [
        {
          "name": "persistence:read",
          "description": "Draft (ADR 0023): browse persistence"
        },
        {
          "name": "persistence:write",
          "description": "Draft (ADR 0023): create, edit, duplicate, teleport"
        },
        {
          "name": "persistence:delete",
          "description": "Draft (ADR 0023): delete items"
        },
        {
          "name": "social:corporation:write",
          "description": "Manage corporations through social's internal API (ADR 0023)"
        },
        {
          "name": "social:politics:write",
          "description": "Manage political entities through social's internal API (ADR 0023)"
        },
        {
          "name": "economie:wallet:read",
          "description": "Read wallets through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:politics:read",
          "description": "Read political treasuries and settings through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:corporation:read",
          "description": "Read corporations' economic settings through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:corporation:manage",
          "description": "Change corporations' economic settings and fiscal home through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:politics:manage",
          "description": "Change political tax rates and minting, run tax assessments through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:wallet:credit",
          "description": "Credit wallets and treasuries through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:wallet:debit",
          "description": "Debit wallets and treasuries through economie's internal API (ADR 0023)"
        },
        {
          "name": "economie:money:issue",
          "description": "Issue money into political treasuries through economie's internal API (ADR 0023)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "dyingstar-admin",
      "name": "DyingStar admin panel (local development only)",
      "description": "Confidential client of the panel BFF: authorization code + PKCE (ADR 0023).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dyingstar-admin-local",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/##http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "panel client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "dyingstar-admin",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": ["openid", "profile", "email", "roles", "web-origins"],
      "optionalClientScopes": ["offline_access"]
    }
  ],
